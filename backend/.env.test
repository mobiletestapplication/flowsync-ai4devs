# Entorno de pruebas. El framework carga este fichero por encima de `.env`
# cuando NODE_ENV=test — lo que pone `node ace test`—, y solo entonces.
#
# Es lo único que separa la batería de pruebas de la base de desarrollo: misma
# configuración, otro puerto. La base del puerto 54411 (servicio `db-test` de
# compose.yaml) vive en memoria y sin volumen, así que cada arranque del
# contenedor empieza vacía.
SESSION_DRIVER=memory

DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
