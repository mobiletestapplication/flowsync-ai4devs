# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Base de datos (PostgreSQL en Docker: `make db-up`)
#--------------------------------------------------------------------
# 54410 es la base de desarrollo del servicio `db` de compose.yaml. La de
# pruebas (54411, servicio `db-test`) se configura en .env.test, que el
# framework carga solo cuando NODE_ENV=test.
DB_HOST=127.0.0.1
DB_PORT=54410
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync
